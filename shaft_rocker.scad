module oem_shaft_rocker() {
    // Left Pivot Pin
    translate([x_c - hub_w/2 - pin_len/2, y_axle, z_axle])
        rotate([0, 90, 0])
            cylinder(r = pin_d/2, h = pin_len, center = true);
            
