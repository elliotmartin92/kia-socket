// Parametric Shaft & Rocker Mechanism for Kia Socket Enclosure
// Generated by build_shaft.py

$fn = 64;

// Global Parameters (mm)
axle_d = 1.9;
axle_r = axle_d / 2;
axle_len = 12.76;

collar_d = 3.0;
collar_t = 0.8;

plunger_reach_below_z = 6.5;
plunger_w = 3.8;
plunger_t = 2.0;
plunger_y_c = 11.4;

input_cam_w = 2.4;
input_cam_x_c = 6.6;

module shaft_rocker() {
    // Main Axle
    rotate([0, 90, 0])
        cylinder(r = axle_r, h = axle_len, center = true);
        
    // Left Collar
    translate([-(axle_len/2 - collar_t/2), 0, 0])
        rotate([0, 90, 0])
            cylinder(r = collar_d/2, h = collar_t, center = true);
            
    // Right Collar
    translate([(axle_len/2 - collar_t/2), 0, 0])
        rotate([0, 90, 0])
            cylinder(r = collar_d/2, h = collar_t, center = true);
}

shaft_rocker();
