// Parametric OEM 3-Rib Shaft & Rocker Mechanism for Kia Socket Enclosure
// Generated by build_shaft.py

$fn = 64;

// Global Parameters (mm)
total_axle_len = 11.5;
hub_w = 7.5;
pin_d = 2.8;
pin_len = 2.00;
hub_d = 4.2;

plunger_reach_below_z = 6.5;
plunger_w = 4.4;
hole_x_c = 10.284;

cam_w = 2.7;
cam_x_c = 6.28;
x_c = 9.25;
y_axle = 9.279;
z_axle = 12.59;

// 2D Profile: Option 1 Direct Straight Belly Cam
poly_cam_pts = [
    [9.279, 12.59],
    [9.279, 15.19],
    [5.00, 9.80],
    [1.50, 7.20],
    [1.80, 5.00],
    [4.50, 5.20],
    [7.779, 10.09]
];

module oem_shaft_rocker() {
    // Left Pivot Pin
    translate([x_c - hub_w/2 - pin_len/2, y_axle, z_axle])
        rotate([0, 90, 0])
            cylinder(r = pin_d/2, h = pin_len, center = true);
            
    // Right Pivot Pin
    translate([x_c + hub_w/2 + pin_len/2, y_axle, z_axle])
        rotate([0, 90, 0])
            cylinder(r = pin_d/2, h = pin_len, center = true);
            
    // Central Hub Barrel
    translate([x_c, y_axle, z_axle])
        rotate([0, 90, 0])
            cylinder(r = hub_d/2, h = hub_w, center = true);
            
    // Direct Straight Belly Cam Tab
    translate([cam_x_c - cam_w/2, 0, 0])
        rotate([0, -90, 0])
            rotate([0, 0, 90])
                linear_extrude(height = cam_w)
                    polygon(poly_cam_pts);
}

oem_shaft_rocker();
